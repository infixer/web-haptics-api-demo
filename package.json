{
  "name": "haptics-morse-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "pnpm --filter @infixer/polyfill-web-haptics-api build && pnpm --filter web dev",
    "dev:polyfill": "pnpm --filter @infixer/polyfill-web-haptics-api dev",
    "build": "pnpm --filter @infixer/polyfill-web-haptics-api build && pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "check": "pnpm --filter @infixer/polyfill-web-haptics-api typecheck && pnpm --filter web check",
    "deploy": "pnpm build && pnpm --filter web deploy"
  }
}
